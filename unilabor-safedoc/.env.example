PORT=4000
CORS_ORIGIN=http://localhost:5173
# Genera un secreto fuerte, p. ej. `openssl rand -hex 32`. El servidor NO arranca
# si JWT_SECRET falta o conserva el valor por defecto "change-me".
JWT_SECRET=change-me
# Expiracion del token JWT (formato de `jsonwebtoken`, p. ej. 8h, 30m, 1d).
JWT_EXPIRES_IN=8h

DB_HOST=localhost
DB_PORT=5432
DB_NAME=safedoc
DB_USER=postgres
DB_PASSWORD=postgres

# Correo via SparkPost (API HTTP). La API key debe tener permiso de transmisiones.
# El dominio de EMAIL_FROM DEBE estar verificado en SparkPost (SPF/DKIM).
# Cuenta EU: usar https://api.eu.sparkpost.com/api/v1
SPARKPOST_API_KEY=change-me
SPARKPOST_API_BASE=https://api.sparkpost.com/api/v1
EMAIL_FROM=no-reply@email.tudominio.mx
EMAIL_FROM_NAME=UNILABOR Contigo+

# Respaldo SMTP (Nodemailer): se usa solo si SPARKPOST_API_KEY no esta definido.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@example.com
SMTP_PASS=change-me

DIRECTORY_UPLOAD=uploads/documents
DIRECTORY_UPLOAD_AVATAR=uploads/avatars
DIRECTORY_UPLOAD_CERTIFICATE=uploads/certificates

# SMS de evaluaciones via LabsMobile (opcional). Si faltan, el canal SMS queda
# deshabilitado y se registra 'skipped' (el correo y el resto del flujo siguen).
LABSMOBILE_USERNAME=usuario@example.com
LABSMOBILE_API_TOKEN=change-me
LABSMOBILE_SENDER=UNILABOR
LABSMOBILE_API_BASE=https://api.labsmobile.com/json/send
# Correo de RH para avisos de no-acreditado (opcional; por defecto usa el de quien
# asigno la evaluacion o, en su defecto, un administrador activo).
NOTIFY_RH_EMAIL=

VIEWER_ALLOWED_CATEGORY_LABELS=SGC ISO 15189,ISO 15189,Sistema de Gestion de Calidad
VIEWER_ALLOWED_CATEGORY_KEYWORDS=iso 15189,15189,sgc,sistema de gestion de calidad

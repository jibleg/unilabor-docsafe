PORT=4000
CORS_ORIGIN=http://localhost:5173
# Genera un secreto fuerte, p. ej. `openssl rand -hex 32`. El servidor NO arranca
# si JWT_SECRET falta o conserva el valor por defecto "change-me".
JWT_SECRET=change-me
# Expiracion del token JWT (formato de `jsonwebtoken`, p. ej. 8h, 30m, 1d).
JWT_EXPIRES_IN=8h

DB_HOST=localhost
DB_PORT=5432
DB_NAME=safedoc
DB_USER=postgres
DB_PASSWORD=postgres

# Correo via SparkPost (SMTP relay). El usuario es literalmente "SMTP_Injection"
# y la contrasena es una API key de SparkPost con permiso "Send via SMTP".
# Region EU: usar smtp.eu.sparkpostmail.com. Puerto 587 (STARTTLS) -> SMTP_SECURE=false.
SMTP_HOST=smtp.sparkpostmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_Injection
SMTP_PASS=change-me
# Remitente: el dominio DEBE estar verificado en SparkPost (SPF/DKIM). Formato
# "Nombre <correo@dominio>" o solo "correo@dominio".
EMAIL_FROM=SafeDoc <no-reply@unilabor.mx>

DIRECTORY_UPLOAD=uploads/documents
DIRECTORY_UPLOAD_AVATAR=uploads/avatars
DIRECTORY_UPLOAD_CERTIFICATE=uploads/certificates

# SMS de evaluaciones via LabsMobile (opcional). Si faltan, el canal SMS queda
# deshabilitado y se registra 'skipped' (el correo y el resto del flujo siguen).
LABSMOBILE_USER=usuario@example.com
LABSMOBILE_TOKEN=change-me
# Remitente alfanumerico opcional (segun plan LabsMobile).
LABSMOBILE_SENDER=Unilabor
# Correo de RH para avisos de no-acreditado (opcional; por defecto usa el de quien
# asigno la evaluacion o, en su defecto, un administrador activo).
NOTIFY_RH_EMAIL=

VIEWER_ALLOWED_CATEGORY_LABELS=SGC ISO 15189,ISO 15189,Sistema de Gestion de Calidad
VIEWER_ALLOWED_CATEGORY_KEYWORDS=iso 15189,15189,sgc,sistema de gestion de calidad
